{
  "name": "xima.music",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:ui-model": "node --experimental-strip-types --test src/features/player/model/*.test.ts",
    "tauri": "tauri",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "release:sign": "bash scripts/sign-release.sh",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@heroui/styles": "3.2.4",
    "@kobalte/core": "0.13.13",
    "@solidjs/router": "1.0.0",
    "@tanstack/solid-virtual": "3.13.36",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-store": "2.4.4",
    "lucide-solid": "1.31.0",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.14"
  }
}
